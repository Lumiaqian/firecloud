/* Supporting-card studies share the score note's dry-media annotation language. */
body{margin:0}
*{box-sizing:border-box}
p,h1,h2,h3,dl,dd{margin:0;font-weight:400}
.study{font:400 16px/1.6 var(--font-hand);color:var(--ink);background:#ddbc9d;min-height:1080px;padding:54px 5% 40px}
.wrap,.pair{max-width:1100px;margin:auto}
.heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 12px 24px}
.heading h1,.heading h2{font-size:27px}
.muted{font-size:13px;color:var(--ink-muted)}
.paper{position:relative;isolation:isolate;filter:drop-shadow(1px 6px 7px #73523716)}
.paper:before{content:'';position:absolute;inset:0;z-index:-1;background:#fdfaf3 url('/_blob/6c40ba3d833c507b0afc53bacaae4405') center/cover;mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat}
.notes{margin-left:35px;padding:40px 43px 32px}
.groups{display:grid;grid-template-columns:1fr 1fr;gap:66px}
.group-title{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-left:25px;margin-bottom:14px}
.group-title h3{font-size:23px;transform:rotate(-3deg);padding:0 4px 9px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 13px no-repeat}
.group-title span{font-size:12px;color:var(--ink-muted)}
.groups dl{padding:0 0 0 25px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/17px 96% no-repeat}
.metric{display:grid;grid-template-columns:1fr auto 44px;gap:14px;align-items:baseline;padding:11px 0}
.metric dt{font-size:16px}
.metric dd{font-size:24px;white-space:nowrap}
.metric dd small{font-size:13px}
.metric .delta{font-size:14px;text-align:right;color:var(--ink-muted)}
.metric.concern{color:var(--ink-selected)}
.metric.concern dd:first-of-type{padding-bottom:4px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center bottom/100% 9px no-repeat}
.metric.concern .delta{color:var(--ink-selected);transform:rotate(-5deg)}
.metric.helpful .delta{color:var(--ink-helpful)}
.margin-note{margin:12px 0 0 4px;display:flex;align-items:center;gap:12px;font-size:17px;color:var(--ink-selected)}
.margin-note:before{content:'';width:86px;height:51px;flex-shrink:0;background:url('/_blob/168794c2c6247d31fb4dd9639d64370c') center/contain no-repeat;transform:rotate(15deg)}
.note-foot{display:flex;justify-content:space-between;gap:20px;margin:17px 0 0 25px;font-size:12px;color:var(--ink-muted)}
.outlook{margin-top:46px}
.scroll{overflow-x:auto;padding:6px 3px 16px;scrollbar-width:thin}
.strip{padding:28px 20px 24px;min-width:900px;display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.strip .day{text-align:center;padding:4px 0;position:relative}
.date{font-size:15px;line-height:1.5}
.number{position:relative;display:grid;place-items:center;height:76px;font-size:42px;line-height:1.1;margin:8px 0 2px;isolation:isolate}
.best .number:before{content:'';position:absolute;inset:0;z-index:-1;background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/104px 72px no-repeat}
.grade{font-size:16px;line-height:1.5}
.strip .day time{display:block;font-size:14px;color:var(--ink-muted);margin-top:6px}
.tag{display:block;font-size:12px;min-height:22px;margin-top:8px;color:var(--ink-muted)}
.current{color:var(--ink-selected)}
.current .number{background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center bottom/52px 10px no-repeat}
.current .tag,.current .date small{color:var(--ink-selected)}
.week-foot{display:flex;justify-content:space-between;gap:20px;font-size:12px;color:var(--ink-muted);margin:12px 12px 0;line-height:1.7}
.source{max-width:1100px;font-size:12px;color:var(--ink-muted);margin:32px auto 0}
/* B: a causal note and an offset seven-day ledger, not two equal panels. */
.pair{display:grid;grid-template-columns:1fr 1fr;gap:66px;align-items:start}
.digest{padding:39px 38px 35px}
.key-label{color:var(--ink-selected);font-size:17px;display:flex;justify-content:space-between;align-items:baseline;gap:15px}
.key-label small{position:relative;font-size:14px;transform:rotate(-4deg)}
.key-label small:after{content:'';position:absolute;right:0;top:20px;width:105px;height:67px;background:url('/_blob/168794c2c6247d31fb4dd9639d64370c') center/contain no-repeat}
.key-readout{display:flex;align-items:baseline;gap:22px;margin:23px 0 7px;color:var(--ink-selected)}
.key-readout strong{font-size:58px;font-weight:400;line-height:1.15;padding:0 3px 10px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center bottom/100% 14px no-repeat}
.key-readout span{font-size:20px;transform:rotate(-5deg)}
.key-note{font-size:16px;margin-top:10px}
.positive{margin:23px 0 27px;padding:18px 0 0;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') top left/100% 7px no-repeat;display:flex;justify-content:space-between;gap:15px;align-items:baseline}
.positive strong{font-size:24px;font-weight:400}
.positive em{font-style:normal;color:var(--ink-helpful);font-size:17px;margin-left:12px}
.remaining-title{font-size:14px;color:var(--ink-muted);margin-bottom:16px}
.remaining{display:grid;grid-template-columns:1fr 1fr;gap:25px 24px;padding-left:22px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/16px 98% no-repeat}
.item dt{font-size:13px;color:var(--ink-muted)}
.item dd{font-size:23px;display:flex;align-items:baseline;gap:12px;margin-top:4px}
.item dd small,.item .unit{font-size:12px;color:var(--ink-muted)}
.digest-foot{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;font-size:12px;margin-top:29px;padding-top:20px;color:var(--ink-muted);background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') top left/100% 7px no-repeat}
.week{margin-top:76px}
.log{padding:23px 29px 26px}
.log .day{display:grid;grid-template-columns:75px 61px minmax(70px,1fr) 58px;align-items:center;gap:10px;min-height:76px;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') center bottom/100% 5px no-repeat}
.log .day:last-of-type{background:none}
.date small,.grade small{display:block;font-size:12px;color:var(--ink-muted)}
.score{position:relative;font-size:35px;line-height:1.2;isolation:isolate;text-align:center}
.log .grade{font-size:15px}
.log .day time{font-size:14px;color:var(--ink-muted);text-align:right}
.current .score{padding-bottom:7px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center bottom/43px 9px no-repeat}
.best .score:before{content:'';position:absolute;inset:-7px -7px;z-index:-1;background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/contain no-repeat}
@media(max-width:950px){.pair{gap:30px}.digest{padding:29px 27px}.log{padding:22px}.log .day{grid-template-columns:62px 50px 1fr 51px;gap:6px}.heading h1,.heading h2{font-size:24px}.remaining{gap:22px}}
@media(max-width:700px){
 .study{padding:30px 20px}.heading{flex-wrap:wrap;margin-left:0}.pair,.groups{grid-template-columns:1fr;gap:32px}.week{margin-top:0}.notes{margin-left:0;padding:29px 24px}.group-title{padding-left:20px}.groups dl{padding-left:20px}.metric{gap:8px;grid-template-columns:1fr auto 35px}.metric dt{font-size:14px}.metric dd{font-size:22px}.metric .delta{font-size:13px}.margin-note{font-size:15px;gap:7px}.margin-note:before{width:45px;height:42px}.note-foot,.week-foot{flex-wrap:wrap;gap:6px}.note-foot{margin-left:20px}.outlook{margin-top:34px}.strip{min-width:875px}.digest{padding:30px 26px}.remaining{column-gap:18px;padding-left:18px}.item dd{font-size:21px;gap:6px;flex-wrap:wrap}.log{padding:20px}.log .day{grid-template-columns:59px 45px 1fr 48px;gap:5px}.log .score{font-size:31px}.log .date,.log .grade{font-size:14px}.log .day time{font-size:13px}.key-readout strong{font-size:52px}.key-label{font-size:15px}.key-label small{font-size:12px}.key-label small:after{width:76px;height:53px}.positive{flex-wrap:wrap;gap:5px}.source{margin-top:30px}
}
