/* Review composition: one focal annotation, a timing slip, a supporting ledger,
   and one continuous forecast fold. Forecast choices never drive the ambient sky. */
.weather-root{--note-paper:#fdfaf3}
.weather-root[data-light=night]{--note-paper:#e7e4d6}
.weather-root .hero{min-height:660px}
.weather-root .paper::before{clip-path:inset(0 round 23px 30px 24px 18px / 15px 22px 20px 26px)}
.weather-root .score-note{container-type:inline-size;width:480px;max-width:100%;padding:0 0 26px;transform:none;bottom:18px;filter:drop-shadow(1px 7px 8px #43352b18)}
.weather-root[data-light] .paper.score-note::before{background:var(--note-paper);clip-path:inset(0 round 23px 30px 24px 18px / 15px 22px 20px 26px)}
.weather-root .score-ink{position:absolute;inset:0 0 auto;width:100%;height:auto;pointer-events:none;mix-blend-mode:multiply;z-index:-1;border-radius:22px}
.weather-root .score-header{position:absolute;left:11.4%;top:6.4cqw;font-size:14px;line-height:22px}
.weather-root .score-note .label{position:absolute;left:18%;top:20cqw;font-size:12px;line-height:20px}
.weather-root .score-note .score-line{position:absolute;left:15%;top:25cqw;margin:0;gap:5px;align-items:baseline}
.weather-root .score-note .score{font-size:clamp(76px,22cqw,124px);line-height:1;letter-spacing:-5px}
.weather-root .score-unit{font-size:12px;color:#625b4e}
.weather-root .score-note .grade{position:absolute;left:61%;top:20cqw;width:31%;font-size:clamp(18px,5.35cqw,30px);line-height:1.35;margin:0;transform:rotate(-4deg);transform-origin:left bottom}
.weather-root .note-advice{padding-top:57cqw;margin:0 9% 0 16%;font-size:16px;line-height:1.7;min-height:0}
.weather-root .score-meta{display:flex;justify-content:space-between;gap:12px;margin:20px 9% 0 11.4%;font-size:12px;color:#625b4e;line-height:1.5}
.weather-root .score-note .note-contacts{border-radius:22px}
.weather-root .sun-note{width:300px;top:100px;right:20px;padding:32px 34px 34px;transform:none;min-height:396px}
.weather-root[data-light] .paper.sun-note::before{background-color:var(--note-paper);background-image:url('/_blob/016c40d1def5678a1bc7b8c1d7ed4199');background-size:100% 100%;background-blend-mode:multiply;clip-path:inset(0 round 17px 23px 18px 26px / 25px 17px 28px 16px)}
.weather-root .sun-note .time{font-size:58px;line-height:1.2;margin:10px 0 22px;letter-spacing:-2px}
.weather-root .sun-note .window{margin:30px 0 0 10px;padding:0 0 0 9px}
.weather-root .sun-note .window::before{display:none}
.weather-root .sun-note .tape,.weather-root .observation .tape{display:none}
.weather-root .sky-caption{left:46%;top:90px;transform:none;letter-spacing:1px;font-size:12px}
.weather-root .horizon{display:none}
.weather-root .moon-link{left:51%;bottom:60px}
.weather-root .comment{justify-content:flex-end;padding:0 22px 8px;min-height:44px}
.weather-root .comment::before{display:none}
.weather-root .observation{width:88%;margin:16px 0 0 auto;padding:32px 40px 26px;filter:drop-shadow(1px 5px 6px #43352b12)}
.weather-root[data-light] .paper.observation::before{background-color:var(--note-paper);clip-path:inset(0 round 22px 16px 26px 19px / 14px 27px 17px 23px)}
.weather-root .observation-heading{padding-bottom:16px;background:url('/_blob/4405eed4803c70a24059951f64fdd8c8') left bottom/100% 10px no-repeat;background-blend-mode:multiply}
.weather-root .observation-heading h2{font-size:24px}
.weather-root .factor-grid{column-gap:32px;row-gap:24px;margin-top:25px}
.weather-root .factor .value{display:flex;justify-content:flex-start;gap:14px;font-size:24px;line-height:1.4}
.weather-root .factor .name{font-size:14px;line-height:1.5;display:block;min-height:21px}
.weather-root .factor .value small{font-size:13px;transform:rotate(-3deg)}
.weather-root .factor-attention .value>span{padding-bottom:5px}
.weather-root .observation details{margin-top:22px}
.weather-root .observation .page-end{margin-top:12px}
.weather-root .outlook{margin-top:44px}
.weather-root .outlook-heading{margin-left:8px;margin-right:8px}
.weather-root .week-fold{min-width:826px;padding:0;filter:drop-shadow(0 5px 5px #43352b15)}
.weather-root .week-fold::before{clip-path:inset(0 round 18px 24px 19px 15px / 10px 14px 15px 12px)}
.weather-root .fold-day{min-height:210px;padding:23px 8px 18px;gap:9px}
.weather-root .fold-day:not(:last-of-type){background:url('/_blob/4405eed4803c70a24059951f64fdd8c8') right center/1px 80% no-repeat}
.weather-root .day-score{font-size:38px}
.weather-root .day-mark{font-size:12px}
.weather-root .week-foot{margin-top:7px}
@media(max-width:900px){
 .weather-root .score-note{width:440px}
 .weather-root .sun-note{width:270px;right:0}
 .weather-root .hero{min-height:740px}
 .weather-root .moon-link{left:auto;right:0;bottom:20px}
 .weather-root .sky-caption{left:0;top:100px}
 .weather-root .observation{width:100%}
}
@media(max-width:600px){
 .weather-root{padding:24px 20px 32px}
 .weather-root .hero{display:flex;flex-direction:column;align-items:flex-start;min-height:0;margin-top:26px;padding-bottom:0}
 .weather-root .tabs{position:static;margin:12px 0 0;gap:18px}
 .weather-root .sky-caption{position:static;margin:7px 0 60px;font-size:12px;letter-spacing:0}
 .weather-root .score-note{position:relative;inset:auto;width:100%;max-width:100%;margin:0 0 26px;padding-bottom:23px;align-self:flex-start}
 .weather-root .score-note .label{font-size:12px}
 .weather-root .score-note .score{font-size:clamp(68px,23cqw,99px)}
 .weather-root .note-advice{font-size:16px;line-height:1.65;margin-right:8%}
 .weather-root .score-header{font-size:13px}
 .weather-root .score-meta{flex-wrap:wrap;gap:4px 12px;margin-top:18px}
 .weather-root .sun-note{position:relative;inset:auto;width:286px;max-width:94%;align-self:flex-end;padding:28px 31px 32px;min-height:380px;margin:0;transform:none}
 .weather-root .sun-note .time{font-size:54px}
 .weather-root .sun-note .window{margin-top:27px;padding-left:8px}
 .weather-root .moon-link{position:static;align-self:flex-start;margin:14px 0 0;font-size:13px}
 .weather-root .comment{padding:0;justify-content:flex-start}
 .weather-root .observation{width:100%;padding:28px 25px 24px;margin-top:22px}
 .weather-root .observation-heading{align-items:flex-start;gap:10px}
 .weather-root .observation-heading h2{font-size:23px;white-space:nowrap}
 .weather-root .observation-heading>span{font-size:12px;line-height:1.6;max-width:110px}
 .weather-root .factor-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:23px 18px}
 .weather-root .factor .value{font-size:22px;gap:8px;flex-wrap:wrap}
 .weather-root .factor .name{font-size:13px;min-height:20px}
 .weather-root .outlook{margin-top:35px}
 .weather-root .outlook-heading{margin-left:0;gap:8px}
 .weather-root .week-scroll{margin:0 -8px}
 .weather-root .week-fold{grid-template-columns:repeat(7,125px);min-width:875px}
 .weather-root .fold-day{min-height:208px}
 .weather-root .moon-body{top:190px;right:34px}
 .weather-root .scene-sun{top:245px!important;right:36px}
}
@media(forced-colors:active){.weather-root .score-ink{display:none}.weather-root .paper::before{background:Canvas!important}.weather-root .observation-heading,.weather-root .fold-day{background-image:none}}
