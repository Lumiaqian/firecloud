/* Selected A{
  clip-path:none;
  background-color:#fdfaf3;
  background-image:url('/_blob/6c40ba3d833c507b0afc53bacaae4405');
  background-position:center;
  background-size:cover;
  background-repeat:no-repeat;
  background-blend-mode:multiply;
  mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat;
} applied to page-specific reading hierarchies.
   Only paper{
  clip-path:none;
  background-color:#fdfaf3;
  background-image:url('/_blob/6c40ba3d833c507b0afc53bacaae4405');
  background-position:center;
  background-size:cover;
  background-repeat:no-repeat;
  background-blend-mode:multiply;
  mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat;
}
:root body .rule::before{
  background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') left center/100% 100% no-repeat;
  height:3px;
}:root body .calibration::before{
  background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') left center/100% 100% no-repeat;
  height:3px;
}
:root body button[aria-pressed=true]::after{
  background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');
  background-repeat:no-repeat;
}:root body .ink-action::after{
  background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');
  background-repeat:no-repeat;
}:root body .primary::after{
  background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');
  background-repeat:no-repeat;
}
:root body .sheet-return::after{
  background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');
  background-repeat:no-repeat;
}:root body .sheet-return span::after{
  background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');
  background-repeat:no-repeat;
}
:root body .head h1{
  width:fit-content;
  padding-bottom:12px;
  background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/90% 10px no-repeat;
}:root body .sheet-title{
  width:fit-content;
  padding-bottom:12px;
  background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/90% 10px no-repeat;
}:root body .paper-head h1{
  width:fit-content;
  padding-bottom:12px;
  background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/90% 10px no-repeat;
}
:root body .search-field{border-bottom:0;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') left bottom/100% 3px no-repeat}:root body .mini-search input{border-bottom:0;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') left bottom/100% 3px no-repeat}
:root body .search-field:focus-within{box-shadow:none;background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');background-size:100% 5px}:root body .mini-search input:focus{box-shadow:none;background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');background-size:100% 5px}:root body .mini-search input[data-focused=true]{box-shadow:none;background-image:url('/_blob/ca21bc89b8a03234da940fcb9db94854');background-size:100% 5px}
/* A drawer is a working sheet{padding-top:37px} with the current location written in its margin. */
:root body .sheet{padding-top:37px}
:root body .sheet .eyebrow{letter-spacing:1px}
:root body .favorites-head h2{
  width:fit-content;padding-bottom:8px;
  background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 7px no-repeat;
}:root body .mini-list h3{
  width:fit-content;padding-bottom:8px;
  background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 7px no-repeat;
}
:root body .favorite-pick{position:relative;background:none;border:0}
:root body .favorite-pick[aria-current=location]{background:none;color:#36372f}
:root body .favorite-pick[aria-current=location] strong{
  text-decoration:none;padding-bottom:7px;
  background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 7px no-repeat;
}
:root body .current{transform:rotate(-5deg);padding:0 0 5px 6px;background:url('/_blob/168794c2c6247d31fb4dd9639d64370c') left bottom/35px 13px no-repeat}
:root body .capacity{margin:4px 0 14px}
:root body .notice{padding:13px 0 13px 20px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/11px 90% no-repeat}
:root body .feedback{background-color:transparent}
:root body .feedback p{padding-left:16px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/8px 90% no-repeat}
:root body .drag-handle{background-image:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd')}:root body .handle{background-image:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd')}
/* Compact forecast remnants retain a circled score{transform:none} never a stamp or selection slab. */
:root body .context-paper{transform:none}
:root body .context-paper:has(.context-grade){display:grid;grid-template-columns:1.15fr 1fr;gap:9px 15px;padding:30px 26px 25px;margin-top:94px}
:root body .context-paper:has(.context-grade)>p:first-of-type{grid-column:1/-1}
:root body .context-paper:has(.context-grade) .context-score{font-size:79px;width:136px;height:125px}
:root body .context-paper .context-score{
  display:inline-grid;place-items:center;flex-shrink:0;
  background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/100% 100% no-repeat;
  color:#98422c;letter-spacing:-2px;
}:root body .forecast-score{
  display:inline-grid;place-items:center;flex-shrink:0;
  background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/100% 100% no-repeat;
  color:#98422c;letter-spacing:-2px;
}:root body .handoff .new-score{
  display:inline-grid;place-items:center;flex-shrink:0;
  background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/100% 100% no-repeat;
  color:#98422c;letter-spacing:-2px;
}:root body .sky-score strong{
  display:inline-grid;place-items:center;flex-shrink:0;
  background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/100% 100% no-repeat;
  color:#98422c;letter-spacing:-2px;
}
:root body .context-grade{position:relative;font-size:25px;align-self:center;padding-bottom:22px;transform:rotate(-4deg)}
:root body .context-grade::after{content:'';position:absolute;left:-18px;bottom:-10px;width:93px;height:40px;background:url('/_blob/168794c2c6247d31fb4dd9639d64370c') center/contain no-repeat;pointer-events:none}
:root body .context-bottom{grid-column:1/-1;margin-top:8px}
:root body .context-paper:not(:has(.context-grade)) .context-score{width:65px;height:64px;font-size:38px}
:root body .handoff .new-score{width:112px;height:94px;font-size:58px;margin:12px 0}
/* The welcome page remains an invitation and a real observation photograph. */
:root body .welcome-spread{gap:74px;margin-top:74px}
:root body .welcome-copy h1{font-size:62px;line-height:1.3;margin-bottom:25px}
:root body .entry-note{padding:27px 29px;margin-top:36px}
:root body .entry-note h2{width:fit-content;padding-bottom:9px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 7px no-repeat}
:root body .entry-note .privacy{padding-left:16px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/8px 100% no-repeat}
:root body .specimen{transform:none;padding:27px 28px 28px;margin-top:54px}
:root body .specimen-photo{clip-path:none;border-radius:2px 6px 3px 5px}
:root body .specimen-summary strong{padding:0 2px 9px;transform:rotate(-3deg);background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 8px no-repeat}
/* Moon phase geometry and timestamps stay independent of the forecast remnant. */
:root body .observation-slip{transform:none;padding-top:32px}
:root body .lunar-values{padding-left:20px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/12px 91% no-repeat}
:root body .lunar-values::before{display:none}
:root body .lunar-values dd{font-size:27px}
:root body .advice h2{width:fit-content;padding-bottom:8px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 7px no-repeat}
:root body .forecast-context{transform:none;padding:23px 25px}
:root body .forecast-score{font-size:45px;width:88px;height:77px}
:root body .forecast-row{justify-content:flex-start;gap:20px}
:root body .forecast-row>span{padding-bottom:12px;background:url('/_blob/168794c2c6247d31fb4dd9639d64370c') left bottom/65px 18px no-repeat}
/* City handoff: one score annotation{gap:30px} one timing note{gap:30px} one grouped cloud record. */
:root body .stack{gap:30px}
:root body .score-slip{padding:31px 32px 28px;transform:none;container-type:inline-size}
:root body .score-slip .annotation{padding-left:20px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/10px 100% no-repeat;font-size:15px;line-height:1.7}
:root body .time-slip{transform:none;padding:31px 34px;gap:26px}
:root body .factors{margin-top:18px;padding-left:21px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/11px 100% no-repeat}
:root body .factor-row{padding:8px 0}
:root body .fold{margin-top:23px}
:root body .days{margin:8px 0 0}
:root body .days li{min-height:40px}
/* Recovered notes are explicitly old records{transform:none;padding:36px 38px 30px;max-width:690px} not fresh forecasts. */
:root body .retained{transform:none}
:root body .retained-data{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:28px;align-items:start;margin:24px 0}
:root body .retained-data>div:first-child{position:relative}
:root body .status-note{transform:none;padding:29px 30px;margin-top:36px}
:root body .status-note h2{padding-left:17px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/8px 90% no-repeat}
/* State-study devices retain their fixed phone viewport and interaction space. */
:root body .sky-score{transform:none;padding:9px 14px;margin-top:12px;display:flex;align-items:center;gap:11px;width:290px;max-width:calc(100% - 48px)}
:root body .sky-score strong{font-size:35px;width:59px;height:56px;margin-right:0}
:root body .mini-sheet{padding-top:15px}
:root body .mini-head h2{padding-bottom:9px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 8px no-repeat}
:root body .mini-privacy{border-top:0;padding-left:14px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left bottom/8px 80% no-repeat}
@media(max-width:900px) and (min-width:601px){
  :root body .context-paper:has(.context-grade){grid-template-columns:1fr;padding:25px 20px}
  :root body .context-paper:has(.context-grade) .context-score{font-size:64px;width:116px;height:104px}
  :root body .context-grade{margin-left:13px;font-size:22px}
  :root body .context-grade::after{display:none}
}
@media(max-width:760px){
  :root body .welcome-spread{grid-template-columns:1fr;gap:34px;margin-top:43px}
  :root body .welcome-copy h1{font-size:48px}
  :root body .specimen{margin:5px 0 0}
}
@media(max-width:600px){
  :root body .sheet{padding-top:21px}
  :root body .head h1{padding-bottom:9px;background-size:90% 8px}
  :root body .favorite-row{min-height:69px}
  :root body .current{padding-left:2px;font-size:12px}
  :root body .context-paper:not(:has(.context-grade)){padding:10px 14px;gap:9px;max-width:100%;width:310px}
  :root body .context-paper:not(:has(.context-grade)) .context-score{width:57px;height:55px;font-size:34px}
  :root body .handoff .new-score{width:88px;height:75px;font-size:45px}
  :root body .entry-note{padding:25px 24px;margin-top:27px}
  :root body .specimen{padding:24px 22px}
  :root body .welcome-copy h1{font-size:47px;margin-bottom:18px}
  :root body .observation-slip{padding:28px 24px 23px}
  :root body .lunar-values{padding-left:17px;gap:21px 14px;background-size:10px 91%}
  :root body .lunar-values dd{font-size:25px}
  :root body .context-row{align-items:flex-start;gap:12px}
  :root body .forecast-context{padding:15px 16px;flex-basis:198px;max-width:63%}
  :root body .forecast-score{font-size:32px;width:62px;height:57px}
  :root body .forecast-row{gap:9px;margin-top:8px}
  :root body .forecast-row>span{padding-bottom:15px;background-size:45px 15px}
  :root body .stack{gap:25px}
  :root body .score-slip{padding:27px 25px 24px}
  :root body .score-slip .annotation{font-size:14px}
  :root body .time-slip{padding:26px 25px;gap:20px}
  :root body .retained-data{grid-template-columns:1fr;gap:21px;margin:21px 0}
  :root body .retained-time{margin:0 0 0 auto}
  :root body .status-note{padding:27px 24px;max-width:97%;margin-top:29px}
  :root body .board{width:100%;height:auto;min-height:100vh;padding:24px 16px;overflow:auto}
  :root body .board-head{flex-wrap:wrap;gap:9px}
  :root body .strip{flex-direction:column;gap:34px;align-items:center}
  :root body .study{width:390px;max-width:100%}
  :root body .device{width:100%}
  :root body .board-footer{flex-wrap:wrap;margin-top:20px}
}
@media(max-width:350px){
  :root body .forecast-context{padding:13px 12px;flex-basis:176px}
  :root body .forecast-score{font-size:29px;width:53px;height:50px}
  :root body .forecast-row{gap:6px}
  :root body .welcome-copy h1{font-size:42px}
}
@media(forced-colors:active){
  :root body .context-score{background:none;color:CanvasText}:root body .forecast-score{background:none;color:CanvasText}:root body .sky-score strong{background:none;color:CanvasText}:root body .new-score{background:none;color:CanvasText}
  :root body .favorite-pick[aria-current=location] strong{text-decoration:underline}:root body button[aria-pressed=true]{text-decoration:underline}
  :root body .search-field{border-bottom:1px solid CanvasText}:root body .mini-search input{border-bottom:1px solid CanvasText}
  :root body button:focus-visible{outline:2px solid Highlight}:root body a:focus-visible{outline:2px solid Highlight}:root body input:focus-visible{outline:2px solid Highlight}
}
