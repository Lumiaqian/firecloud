/* Recovery A: city-level status{box-sizing:border-box;font-family:var(--font-hand),sans-serif!important;font-weight:400;font-synthesis:none} two retained papers{box-sizing:border-box;font-family:var(--font-hand),sans-serif!important;font-weight:400;font-synthesis:none} dedicated no-record states. */

*{box-sizing:border-box;font-family:var(--font-hand),sans-serif!important;font-weight:400;font-synthesis:none}body{margin:0;color:#36372f}h1{margin:0}h2{margin:0}p{margin:0}p{line-height:1.75}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;line-height:1.5}button{min-height:44px;min-width:44px;border:0;background:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:10px 4px;position:relative}a.action{min-height:44px;min-width:44px;border:0;background:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:10px 4px;position:relative}button:focus-visible{outline:none;text-decoration:underline dashed;text-decoration-thickness:1.5px;text-underline-offset:6px}a:focus-visible{outline:none;text-decoration:underline dashed;text-decoration-thickness:1.5px;text-underline-offset:6px}button:disabled{cursor:default;opacity:.8}button[aria-pressed=true]{color:#a63827}button[aria-pressed=true]::after{content:'';position:absolute;left:2px;right:2px;bottom:1px;height:8px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center/100% 100% no-repeat;pointer-events:none}.ink-action{color:#a63827}
.sky-page{--note-paper:#fdfaf3;--status-ink:#8e3924;min-height:1000px;background:linear-gradient(180deg,#bdccd5,#d5b29d 52%,#edcd9a);padding:30px 5% 36px;position:relative;isolation:isolate}.sky-page[data-light=night]{--note-paper:#e7e4d6;--status-ink:#ffcfab;background:linear-gradient(180deg,#142936,#2b414b 52%,#56646a);color:#edece1}.inner{max-width:1100px;margin:auto}.page-top{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{display:flex;align-items:center;gap:10px;font-size:23px;min-height:44px}.brand img{width:42px;height:42px}.brand small{display:block;font-size:12px;letter-spacing:2px;margin-top:4px}
.feedback-layout{max-width:1000px;margin:48px auto 0}.feedback-context{display:flex;justify-content:space-between;align-items:baseline;gap:20px}.feedback-context h1{font-size:42px;color:var(--status-ink);line-height:1.3}.feedback-context p{font-size:13px;margin-top:7px}.feedback-tabs{display:flex;gap:20px}.feedback-tabs button{font-size:18px}.sky-page[data-light=night] .feedback-tabs button[aria-pressed=true]{color:#ffcfab}
.record-status{display:grid;grid-template-columns:minmax(0,1fr) 156px;align-items:center;gap:16px;min-height:88px;margin-top:10px;font-size:13px;line-height:1.65}.record-copy{display:flex;flex-direction:column;align-items:flex-start;gap:0;line-height:1.65}.record-state{color:var(--status-ink)}.record-actions{display:grid;grid-template-columns:88px 60px;align-items:center;gap:8px}.record-actions button{font-size:14px;color:var(--status-ink);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}.record-cancel[data-available=false]{visibility:hidden}.record-actions button:focus-visible{text-decoration-style:dashed}.record-status[data-state=switchfailed] .record-state{color:var(--status-ink)}
.retained-stage{display:grid;grid-template-columns:minmax(0,480px) 300px;justify-content:space-between;align-items:start;gap:32px 44px;margin-top:26px}.retained{margin-top:88px}
.retained-time{margin-top:8px}.record-footer{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:28px;font-size:13px}.record-footer a{padding-left:0}.page-foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;font-size:12px;margin-top:38px;line-height:1.7}
.status-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;margin-top:13px}.status-actions a{font-size:14px}.status-actions button:not(.ink-action){font-size:14px}.blank-stage{max-width:560px;margin:52px auto 70px;position:relative}.state-symbol{width:100px;height:52px;color:#8e7961}.loading-sky{position:relative;width:180px;height:105px;margin-bottom:12px;overflow:hidden}.loading-sky::before{content:'';position:absolute;left:0;right:0;top:82px;height:5px;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') center/100% 100% no-repeat}.loading-sun{position:absolute;width:48px;height:47px;left:65px;top:22px;border:1px solid #a56b3d;border-radius:49% 51% 48% 52%;background:#e8c79055;animation:loading-rise 3.2s ease-in-out infinite}.loading-caption{font-size:12px;line-height:1.6;margin-top:24px;color:#625b4e}
@keyframes loading-rise{0%,100%{transform:translateY(17px);opacity:.5}50%{transform:translateY(-8px);opacity:.9}}
@media(max-width:900px) and (min-width:601px){.retained-stage{grid-template-columns:minmax(0,430px) 270px;gap:26px}.retained{margin-top:120px}}
@media(max-width:600px){.sky-page{padding:24px 20px 32px;min-height:100vh}.brand{font-size:20px;gap:8px}.brand img{width:34px;height:34px}.brand small{font-size:12px;letter-spacing:1px}.page-top>.action{font-size:13px}.feedback-layout{margin-top:31px}.feedback-context{gap:10px;align-items:center}.feedback-context h1{font-size:36px}.feedback-context p{font-size:12px;margin-top:6px}.feedback-tabs{gap:8px}.feedback-tabs button{font-size:17px}.record-status{grid-template-columns:minmax(0,1fr) 76px;gap:8px;font-size:12px;min-height:88px}.record-actions{grid-template-columns:1fr;gap:0}.record-actions button{padding:8px 0}.record-copy{gap:1px}.retained-stage{display:flex;flex-direction:column;gap:30px;margin-top:26px}.retained{margin:0}.retained-time{align-self:flex-end;margin:0}.record-footer{align-items:flex-start;flex-direction:column;gap:0}.blank-stage{margin:34px 0 45px}.status-actions{gap:6px 16px}.page-foot{margin-top:28px;font-size:12px;gap:4px}.loading-sky{height:100px}}
@media(hover:hover) and (pointer:fine){button:hover:not(:disabled){color:#a63827}a:hover{color:#a63827}.sky-page[data-light=night] .page-top a:hover{color:#ffcfab}.sky-page[data-light=night] .feedback-tabs button:hover{color:#ffcfab}.sky-page[data-light=night] .record-footer a:hover{color:#ffcfab}}
@media(prefers-reduced-motion:reduce){.loading-sun{animation:none}}
@media(forced-colors:active){.sky-page{background:Canvas!important;color:CanvasText!important;--status-ink:LinkText}button:focus-visible{outline:2px solid Highlight;outline-offset:2px}a:focus-visible{outline:2px solid Highlight;outline-offset:2px}button[aria-pressed=true]{text-decoration:underline}}
