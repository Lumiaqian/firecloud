/* Recovery A: city-level status, two retained papers, dedicated no-record states. */
@font-face{font-family:Hand;src:url('/_blob/b01b7373b008c76f7ec6d7b19468d11f')}
*{box-sizing:border-box;font-family:Hand,sans-serif!important;font-weight:400;font-synthesis:none}body{margin:0;color:#36372f}h1,h2,p{margin:0}p{line-height:1.75}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;line-height:1.5}button,a.action{min-height:44px;min-width:44px;border:0;background:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:10px 4px;position:relative}button:focus-visible,a:focus-visible{outline:none;text-decoration:underline dashed;text-decoration-thickness:1.5px;text-underline-offset:6px}button:disabled{cursor:default;opacity:.8}button[aria-pressed=true]{color:#a63827}button[aria-pressed=true]::after{content:'';position:absolute;left:2px;right:2px;bottom:1px;height:8px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center/100% 100% no-repeat;pointer-events:none}.ink-action{color:#a63827}
.sky-page{--note-paper:#fdfaf3;--status-ink:#8e3924;min-height:1000px;background:linear-gradient(180deg,#bdccd5,#d5b29d 52%,#edcd9a);padding:30px 5% 36px;position:relative;isolation:isolate}.sky-page[data-light=night]{--note-paper:#e7e4d6;--status-ink:#ffcfab;background:linear-gradient(180deg,#142936,#2b414b 52%,#56646a);color:#edece1}.inner{max-width:1100px;margin:auto}.page-top{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{display:flex;align-items:center;gap:10px;font-size:23px;min-height:44px}.brand img{width:42px;height:42px}.brand small{display:block;font-size:12px;letter-spacing:2px;margin-top:4px}
.paper{position:relative;isolation:isolate;color:#36372f;filter:drop-shadow(1px 5px 6px #43352b12)}.paper::before{content:'';position:absolute;inset:0;z-index:-2;background:var(--note-paper) url('/_blob/6c40ba3d833c507b0afc53bacaae4405') center/100% 100% no-repeat;background-blend-mode:multiply;mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat}
.feedback-layout{max-width:1000px;margin:48px auto 0}.feedback-context{display:flex;justify-content:space-between;align-items:baseline;gap:20px}.feedback-context h1{font-size:42px;color:var(--status-ink);line-height:1.3}.feedback-context p{font-size:13px;margin-top:7px}.feedback-tabs{display:flex;gap:20px}.feedback-tabs button{font-size:18px}.sky-page[data-light=night] .feedback-tabs button[aria-pressed=true]{color:#ffcfab}
.record-status{display:grid;grid-template-columns:minmax(0,1fr) 156px;align-items:center;gap:16px;min-height:88px;margin-top:10px;font-size:13px;line-height:1.65}.record-copy{display:flex;flex-direction:column;align-items:flex-start;gap:0;line-height:1.65}.record-state{color:var(--status-ink)}.record-actions{display:grid;grid-template-columns:88px 60px;align-items:center;gap:8px}.record-actions button{font-size:14px;color:var(--status-ink);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px}.record-cancel[data-available=false]{visibility:hidden}.record-actions button:focus-visible{text-decoration-style:dashed}.record-status[data-state=switchfailed] .record-state{color:var(--status-ink)}
.retained-stage{display:grid;grid-template-columns:minmax(0,480px) 300px;justify-content:space-between;align-items:start;gap:32px 44px;margin-top:26px}.retained{container-type:inline-size;width:100%;margin-top:88px;padding:0 0 25px}.score-ink{position:absolute;inset:0 0 auto;width:100%;height:auto;max-height:100%;object-fit:cover;object-position:top;pointer-events:none;mix-blend-mode:multiply;z-index:-1;mask-image:url('/_blob/839b3299bb39dc8954afdaae34a320f0'),linear-gradient(#000 65%,transparent 98%);mask-size:100% 100%;mask-repeat:no-repeat;mask-composite:intersect}.retained-header{position:absolute;left:11.4%;top:6.4cqw;font-size:14px;line-height:22px}.retained-label{position:absolute;left:18%;top:20cqw;font-size:12px;line-height:20px}.retained-score-line{position:absolute;left:15%;top:25cqw;display:flex;align-items:baseline;gap:6px}.retained-score{font-size:clamp(76px,22cqw,124px);line-height:1;letter-spacing:-5px;color:#376278}.retained-score-line small{font-size:13px}.retained-grade{position:absolute;left:61%;top:20cqw;width:31%;font-size:clamp(16px,5.35cqw,30px);line-height:1.35;transform:rotate(-4deg);transform-origin:left bottom}.retained-verdict{padding-top:57cqw;margin:0 9% 0 16%;font-size:16px;line-height:1.7}.retained-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;margin:20px 9% 0 11.4%;font-size:12px;color:#625b4e;line-height:1.5}
.retained-time{width:300px;padding:31px 34px 28px;min-height:370px;margin-top:8px}.retained-time::before{background-image:url('/_blob/016c40d1def5678a1bc7b8c1d7ed4199'),url('/_blob/6c40ba3d833c507b0afc53bacaae4405');background-size:100% 100%;background-blend-mode:multiply}.note-clip{position:absolute;right:27px;top:-18px;width:25px;height:52px}.retained-time .time{font-size:58px;line-height:1.2;margin:10px 0 22px;letter-spacing:-2px}.retained-time .event-day{font-size:14px;margin-top:2px}.retained-time .azimuth{font-size:12px;margin-top:10px;color:#625b4e}.retained-time .window{margin:30px 0 0 10px;padding-left:9px}.retained-time .window p{font-size:23px;margin:9px 0}.retained-time .window small{font-size:12px}.note-label{font-size:13px;color:#625b4e}.record-footer{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-top:28px;font-size:13px}.record-footer a{padding-left:0}.page-foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;font-size:12px;margin-top:38px;line-height:1.7}
.status-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;margin-top:13px}.status-actions a,.status-actions button:not(.ink-action){font-size:14px}.blank-stage{max-width:560px;margin:52px auto 70px;position:relative}.empty-paper,.loading-note{padding:30px 35px 26px}.empty-paper h1,.loading-title{font-size:32px;line-height:1.5;margin:12px 0 17px;padding-bottom:10px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/220px 11px no-repeat}.empty-paper p,.loading-copy{font-size:17px;padding-left:25px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/13px 94% no-repeat}.state-symbol{width:100px;height:52px;color:#8e7961}.loading-sky{position:relative;width:180px;height:105px;margin-bottom:12px;overflow:hidden}.loading-sky::before{content:'';position:absolute;left:0;right:0;top:82px;height:5px;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') center/100% 100% no-repeat}.loading-sun{position:absolute;width:48px;height:47px;left:65px;top:22px;border:1px solid #a56b3d;border-radius:49% 51% 48% 52%;background:#e8c79055;animation:loading-rise 3.2s ease-in-out infinite}.loading-caption{font-size:12px;line-height:1.6;margin-top:24px;color:#625b4e}
@keyframes loading-rise{0%,100%{transform:translateY(17px);opacity:.5}50%{transform:translateY(-8px);opacity:.9}}
@media(max-width:900px) and (min-width:601px){.retained-stage{grid-template-columns:minmax(0,430px) 270px;gap:26px}.retained-time{width:270px;padding:28px}.retained{margin-top:120px}}
@media(max-width:600px){.sky-page{padding:24px 20px 32px;min-height:100vh}.brand{font-size:20px;gap:8px}.brand img{width:34px;height:34px}.brand small{font-size:12px;letter-spacing:1px}.page-top>.action{font-size:13px}.feedback-layout{margin-top:31px}.feedback-context{gap:10px;align-items:center}.feedback-context h1{font-size:36px}.feedback-context p{font-size:12px;margin-top:6px}.feedback-tabs{gap:8px}.feedback-tabs button{font-size:17px}.record-status{grid-template-columns:minmax(0,1fr) 76px;gap:8px;font-size:12px;min-height:88px}.record-actions{grid-template-columns:1fr;gap:0}.record-actions button{padding:8px 0}.record-copy{gap:1px}.retained-stage{display:flex;flex-direction:column;gap:30px;margin-top:26px}.retained{margin:0;padding-bottom:23px}.retained-header{font-size:13px}.retained-score{font-size:clamp(68px,23cqw,99px)}.retained-verdict{font-size:16px;line-height:1.65}.retained-meta{margin-top:18px}.retained-time{align-self:flex-end;width:286px;max-width:94%;padding:28px 31px;min-height:354px;margin:0}.retained-time .time{font-size:54px}.retained-time .window{margin-top:25px;padding-left:8px}.record-footer{align-items:flex-start;flex-direction:column;gap:0}.blank-stage{margin:34px 0 45px}.empty-paper,.loading-note{padding:26px 24px}.empty-paper h1,.loading-title{font-size:27px;margin-top:8px}.empty-paper p,.loading-copy{font-size:16px}.status-actions{gap:6px 16px}.page-foot{margin-top:28px;font-size:12px;gap:4px}.loading-sky{height:100px}}
@media(hover:hover) and (pointer:fine){button:hover:not(:disabled),a:hover{color:#a63827}.sky-page[data-light=night] .page-top a:hover,.sky-page[data-light=night] .feedback-tabs button:hover,.sky-page[data-light=night] .record-footer a:hover{color:#ffcfab}}
@media(prefers-reduced-motion:reduce){.loading-sun{animation:none}}
@media(forced-colors:active){.sky-page{background:Canvas!important;color:CanvasText!important;--status-ink:LinkText}button:focus-visible,a:focus-visible{outline:2px solid Highlight;outline-offset:2px}.paper::before{background:Canvas!important;mask:none;border:1px solid CanvasText}.score-ink,.note-clip{display:none}.empty-paper p,.loading-copy,.empty-paper h1,.loading-title{background-image:none}button[aria-pressed=true]{text-decoration:underline}}
