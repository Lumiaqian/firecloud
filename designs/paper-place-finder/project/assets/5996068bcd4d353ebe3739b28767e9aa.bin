/* Selected A across the weather atlas and interaction studies.
   The named handset container, not the 1740px atlas viewport, owns phone layout. */
@container handset (max-width:600px){
 .scenario-frame .weather-root{padding:24px 20px 32px}
 .scenario-frame .weather-root .hero{display:flex;flex-direction:column;align-items:flex-start;min-height:0;margin-top:26px;padding-bottom:0}
 .scenario-frame .weather-root .tabs{position:static;margin:12px 0 0;gap:18px}
 .scenario-frame .weather-root .sky-caption{position:static;margin:7px 0 60px;font-size:12px;letter-spacing:0;transform:none}
 .scenario-frame .weather-root .score-note{position:relative;inset:auto;width:100%;max-width:100%;margin:0 0 26px;padding:0 0 23px;align-self:flex-start;transform:none}
 .scenario-frame .weather-root .score-note .score{font-size:clamp(68px,23cqw,99px)}
 .scenario-frame .weather-root .score-header{font-size:13px}
 .scenario-frame .weather-root .note-advice{font-size:16px;line-height:1.65;margin-right:8%}
 .scenario-frame .weather-root .score-meta{flex-wrap:wrap;gap:4px 12px;margin-top:18px}
 .scenario-frame .weather-root .sun-note{position:relative;inset:auto;width:286px;max-width:94%;align-self:flex-end;padding:28px 31px 32px;min-height:380px;margin:0;transform:none}
 .scenario-frame .weather-root .sun-note .time{font-size:54px}
 .scenario-frame .weather-root .sun-note .window{margin-top:27px;padding-left:8px}
 .scenario-frame .weather-root .moon-link{position:static;align-self:flex-start;margin:14px 0 0;font-size:13px}
 .scenario-frame .weather-root .comment{padding:0;justify-content:flex-start}
 .scenario-frame .weather-root .observation{width:100%;padding:29px 24px 24px;margin-top:0}
 .scenario-frame .weather-root .observation-heading{align-items:baseline;flex-wrap:wrap;gap:10px;margin-top:22px}
 .scenario-frame .weather-root .observation-heading h2{font-size:23px;white-space:nowrap}
 .scenario-frame .weather-root .observation-heading>span{font-size:12px;line-height:1.6;max-width:none;text-align:left}
 .scenario-frame .weather-root .factor-groups{grid-template-columns:1fr;gap:32px}
 .scenario-frame .weather-root .factor-group-heading,.scenario-frame .weather-root .factor-grid{padding-left:20px}
 .scenario-frame .weather-root .factor{gap:8px}
 .scenario-frame .weather-root .factor .value{grid-template-columns:auto 35px;font-size:22px;gap:8px}
 .scenario-frame .weather-root .factor .name{font-size:14px}
 .scenario-frame .weather-root .factor .value small{font-size:13px}
 .scenario-frame .weather-root .factor-margin{font-size:15px;gap:7px}
 .scenario-frame .weather-root .factor-margin::before{width:45px;height:42px}
 .scenario-frame .weather-root .outlook{margin-top:35px}
 .scenario-frame .weather-root .outlook-heading{margin-left:0;gap:8px}
 .scenario-frame .weather-root .week-scroll{margin:0 -8px}
 .scenario-frame .weather-root .week-fold{grid-template-columns:repeat(7,125px);min-width:915px}
 .scenario-frame .weather-root .fold-day{min-height:206px}
 .scenario-frame .weather-root .moon-body{top:190px;right:34px;left:auto}
 .scenario-frame .weather-root .scene-sun{top:245px;right:36px;left:auto}
}
/* Motion remains live: the score annotation replaces the former stamp gesture. */
.motion-study[data-night]{--note-paper:#fdfaf3}
.motion-study[data-night=true]{--note-paper:#e7e4d6}
.motion-study[data-night] .hero{min-height:660px}
.motion-study[data-night] .paper::before{background:var(--note-paper);clip-path:inset(0 round 23px 30px 24px 18px / 15px 22px 20px 26px)}
.motion-study[data-night] .score-note{container-type:inline-size;left:0;top:auto;bottom:18px;width:480px;max-width:100%;padding:0 0 26px;transform:none;filter:drop-shadow(1px 7px 8px #43352b18)}
.motion-study[data-night] .score-ink{position:absolute;inset:0 0 auto;width:100%;height:auto;z-index:-1;pointer-events:none;mix-blend-mode:multiply;border-radius:22px;mask-image:linear-gradient(#000 65%,transparent 98%)}
.motion-study[data-night] .score-header{position:absolute;left:11.4%;top:6.4cqw;font-size:14px;line-height:22px}
.motion-study[data-night] .score-note>.label{position:absolute;left:18%;top:20cqw;font-size:12px;line-height:20px}
.motion-study[data-night] .score-line{position:absolute;left:15%;top:25cqw;margin:0;gap:5px;align-items:baseline}
.motion-study[data-night] .score{font-size:clamp(76px,22cqw,124px);line-height:1;letter-spacing:-5px}
.motion-study[data-night] .grade{position:absolute;left:61%;top:20cqw;width:31%;font-size:clamp(16px,5.35cqw,30px);line-height:1.35;margin:0;transform:rotate(-4deg)}
.motion-study[data-night] .score-warm{padding:0;font-size:inherit;text-align:left;min-height:44px;line-height:inherit;color:#a23f25;transition:filter 160ms ease}
.motion-study[data-night] .score-warm::after{display:none}
.motion-study[data-night] .score-warm:focus-visible{outline:1px dashed #9b3c29;outline-offset:4px}
.motion-study[data-warm=true] .score-warm{filter:drop-shadow(0 0 9px #c7793b80)}
.motion-study[data-night] .note-advice{padding-top:57cqw;margin:0 9% 0 16%;font-size:16px;line-height:1.7}
.motion-study[data-night] .score-meta{display:flex;justify-content:space-between;gap:12px;margin:20px 9% 0 11.4%;font-size:12px;color:#625b4e;line-height:1.5}
.motion-study[data-night] .sun-note{width:300px;top:100px;right:20px;padding:32px 34px 34px;transform:none;min-height:396px}
.motion-study[data-night] .sun-note::before{background:var(--note-paper) url('/_blob/016c40d1def5678a1bc7b8c1d7ed4199') center/100% 100% no-repeat;background-blend-mode:multiply;clip-path:inset(0 round 17px 23px 18px 26px / 25px 17px 28px 16px)}
.motion-study[data-night] .sun-note .time{font-size:58px;line-height:1.2;margin:10px 0 22px;letter-spacing:-2px}
.motion-study[data-night] .sun-note .window{margin:30px 0 0 10px;padding:0 0 0 9px}
.motion-study[data-night] .window::before{display:none}
.motion-study[data-night] .sky-note{position:absolute;left:51%;bottom:55px;max-width:36%;font-size:13px}
.motion-study[data-night] .study-factors{position:relative;width:97%;margin:0 0 0 auto;padding:40px 43px 28px}
.motion-study[data-night] .study-factors::before{background:var(--note-paper);clip-path:none;mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat}
.motion-study[data-night] .factor-top{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:16px 8px 24px}
.motion-study[data-night] .factor-top h2{font-size:27px}
.motion-study[data-night] .factor-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:60px}
.motion-study[data-night] .factor-group-heading{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding-left:25px;margin-bottom:14px}
.motion-study[data-night] .factor-group-heading h3{font-size:23px;margin:0;transform:rotate(-3deg);padding:0 4px 9px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/100% 13px no-repeat}
.motion-study[data-night] .factor-group-heading>span{font-size:12px;color:#625b4e}
.motion-study[data-night] .factor-grid{display:block;margin:0;padding-left:25px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/17px 96% no-repeat}
.motion-study[data-night] .factor-grid>div{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:baseline;gap:14px;padding:11px 0}
.motion-study[data-night] .factor-grid small{font-size:16px;line-height:1.5;color:inherit}
.motion-study[data-night] .factor-grid p{display:grid;grid-template-columns:auto 44px;gap:14px;font-size:24px;line-height:1.4;margin:0}
.motion-study[data-night] .factor-grid p span{font-size:14px;text-align:right;transform:rotate(-3deg);margin:0}
.motion-study[data-night] .factor-margin{display:flex;align-items:center;gap:12px;margin:14px 0 0 4px;font-size:17px;line-height:1.6;color:#a23f25}
.motion-study[data-night] .factor-margin::before{content:'';width:86px;height:51px;flex-shrink:0;background:url('/_blob/168794c2c6247d31fb4dd9639d64370c') center/contain no-repeat;transform:rotate(15deg)}
.motion-study[data-night] .paper-hint{margin-top:22px}
.motion-study[data-night] .outlook{margin-top:44px}
.motion-study[data-night] .week-fold{min-width:900px;padding:28px 20px 24px}
.motion-study[data-night] .week-fold::before{background:var(--note-paper) url('/_blob/6c40ba3d833c507b0afc53bacaae4405') center/cover no-repeat;clip-path:none;mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat}
.motion-study[data-night] .fold-day{min-height:206px;padding:4px 0;gap:8px}
.motion-study[data-night] .fold-day strong{position:relative;display:grid;place-items:center;font-size:42px;height:76px;line-height:1.1;margin:8px 0 2px;isolation:isolate}
.motion-study[data-night] .fold-day[data-best=true] strong::before{content:'';position:absolute;inset:0 -20px;z-index:-1;background:url('/_blob/866c37972149fbf785c2705c9d2d3678') center/104px 72px no-repeat}
.motion-study[data-night] .fold-day::after{display:none}
.motion-study[data-night] .fold-day[aria-pressed=true] strong::after{content:'';position:absolute;left:50%;bottom:0;width:52px;height:10px;transform:translateX(-50%);background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center/contain no-repeat}
.motion-study[data-night] .fold-day span{font-size:14px}
@media(max-width:700px){
 .motion-study[data-night] .hero{display:flex;flex-direction:column;align-items:flex-start;min-height:0;margin-top:26px;padding-bottom:0}
 .motion-study[data-night] .gesture{position:relative;inset:auto;align-self:flex-end;width:75%;height:110px;margin:4px 0 32px}
 .motion-study[data-night] .score-note{position:relative;inset:auto;width:100%;margin:0 0 26px;padding-bottom:23px}
 .motion-study[data-night] .score{font-size:clamp(68px,23cqw,99px)}
 .motion-study[data-night] .score-header{font-size:13px}
 .motion-study[data-night] .note-advice{line-height:1.65}
 .motion-study[data-night] .score-meta{flex-wrap:wrap;gap:4px 12px;margin-top:18px}
 .motion-study[data-night] .sun-note{position:relative;inset:auto;width:286px;max-width:94%;align-self:flex-end;padding:28px 31px 32px;min-height:380px;margin:0}
 .motion-study[data-night] .sun-note .time{font-size:54px}
 .motion-study[data-night] .sun-note .window{margin-top:27px;padding-left:8px}
 .motion-study[data-night] .sky-note{position:static;max-width:none;margin:14px 0 24px}
 .motion-study[data-night] .study-factors{width:100%;padding:29px 24px 24px;margin:0}
 .motion-study[data-night] .factor-top{flex-wrap:wrap;gap:10px;margin-top:22px}
 .motion-study[data-night] .factor-top h2{font-size:23px}
 .motion-study[data-night] .factor-groups{grid-template-columns:1fr;gap:32px}
 .motion-study[data-night] .factor-group-heading,.motion-study[data-night] .factor-grid{padding-left:20px}
 .motion-study[data-night] .factor-grid>div{gap:8px}
 .motion-study[data-night] .factor-grid small{font-size:14px}
 .motion-study[data-night] .factor-grid p{grid-template-columns:auto 35px;font-size:22px;gap:8px}
 .motion-study[data-night] .factor-grid p span{font-size:13px}
 .motion-study[data-night] .factor-margin{font-size:15px;gap:7px}
 .motion-study[data-night] .factor-margin::before{width:45px;height:42px}
 .motion-study[data-night] .outlook{margin-top:35px}
 .motion-study[data-night] .week-fold{grid-template-columns:repeat(7,125px);min-width:915px}
}
@media(forced-colors:active){
 .motion-study[data-night] .score-ink{display:none}
 .motion-study[data-night] .paper::before,.motion-study[data-night] .week-fold::before{background:Canvas}
 .motion-study[data-night] .score-warm{color:ButtonText}
 .motion-study[data-night] .fold-day[aria-pressed=true] strong{text-decoration:underline}
}
