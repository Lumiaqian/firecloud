/* Recovery notes share the approved home A ink grammar; saved data stays distinct from status. */
@font-face{font-family:Hand;src:url('/_blob/b01b7373b008c76f7ec6d7b19468d11f')}
*{box-sizing:border-box;font-family:Hand,sans-serif!important;font-weight:400}body{margin:0;color:#36372f}h1,h2,p{margin:0}p{line-height:1.75}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;line-height:1.5}button,a.action{min-height:44px;min-width:44px;border:0;background:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;padding:10px 4px;position:relative}button:focus-visible,a:focus-visible{outline:none;text-decoration:underline dashed;text-decoration-thickness:1.5px;text-underline-offset:6px}button:disabled{color:#625b4e;cursor:default}button[aria-pressed=true],.ink-action{color:#a63827}button[aria-pressed=true]::after,.ink-action::after{content:'';position:absolute;left:2px;right:2px;bottom:1px;height:8px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') center/100% 100% no-repeat;pointer-events:none}
.sky-page{--note-paper:#fdfaf3;min-height:1000px;background:linear-gradient(180deg,#bdccd5,#d5b29d 52%,#edcd9a);padding:30px 5% 36px;position:relative;isolation:isolate}.sky-page[data-light=night]{--note-paper:#e7e4d6;background:linear-gradient(180deg,#142936,#2b414b 52%,#56646a);color:#edece1}.inner{max-width:1100px;margin:auto}.page-top{display:flex;justify-content:space-between;align-items:center;gap:16px}.brand{display:flex;align-items:center;gap:10px;font-size:23px;min-height:44px}.brand img{width:42px;height:42px}.brand small{display:block;font-size:11px;letter-spacing:3px;margin-top:4px}.paper{position:relative;isolation:isolate;color:#36372f}.paper::before{content:'';position:absolute;inset:0;z-index:-1;background:var(--note-paper) url('/_blob/6c40ba3d833c507b0afc53bacaae4405') center/100% 100% no-repeat;mask:url('/_blob/839b3299bb39dc8954afdaae34a320f0') center/100% 100% no-repeat}.feedback-layout{max-width:1000px;margin:48px auto 0}.feedback-context{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:27px;gap:20px}.feedback-context h1{font-size:42px}.feedback-context p{font-size:13px;margin-top:7px}.feedback-tabs{display:flex;gap:20px}.feedback-tabs button{font-size:18px}.status-note{width:510px;max-width:100%;margin:0 0 32px auto;padding:23px 30px 21px}.status-note h2{font-size:23px;line-height:1.5;padding-bottom:10px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/190px 10px no-repeat}.status-note p{font-size:15px;color:#625b4e;margin:13px 0 0;padding-left:22px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/12px 94% no-repeat}.status-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;margin-top:13px}.status-actions a,.status-actions button:not(.ink-action){font-size:14px}.retained-stage{display:grid;grid-template-columns:minmax(0,480px) 300px;justify-content:space-between;align-items:start;gap:32px 44px}.retained{container-type:inline-size;width:100%;margin-top:45px;padding:0 0 25px;filter:drop-shadow(1px 7px 8px #43352b18)}.retained::before{background:var(--note-paper);mask:none;border-radius:23px 30px 24px 18px / 15px 22px 20px 26px}.score-ink{position:absolute;inset:0 0 auto;width:100%;height:auto;pointer-events:none;mix-blend-mode:multiply;z-index:-1;border-radius:22px;mask-image:linear-gradient(#000 65%,transparent 98%)}.retained-header{position:absolute;left:11.4%;top:6.4cqw;font-size:14px;line-height:22px}.retained-label{position:absolute;left:18%;top:20cqw;font-size:12px;line-height:20px}.retained-score{position:absolute;left:15%;top:25cqw;font-size:clamp(76px,22cqw,124px);line-height:1;letter-spacing:-5px}.retained-grade{position:absolute;left:61%;top:20cqw;width:31%;font-size:clamp(16px,5.35cqw,30px);line-height:1.35;transform:rotate(-4deg);transform-origin:left bottom}.retained-verdict{padding-top:57cqw;margin:0 9% 0 16%;font-size:16px;line-height:1.7}.retained-meta{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 12px;margin:20px 9% 0 11.4%;font-size:12px;color:#625b4e;line-height:1.5}.retained-time{width:300px;padding:32px 34px 34px;min-height:340px}.retained-time::before{background:var(--note-paper) url('/_blob/016c40d1def5678a1bc7b8c1d7ed4199') center/100% 100% no-repeat;background-blend-mode:multiply;mask:none;border-radius:17px 23px 18px 26px / 25px 17px 28px 16px}.retained-time .time{font-size:58px;line-height:1.2;margin:10px 0 22px;letter-spacing:-2px}.retained-time .window{margin:30px 0 0 10px;padding-left:9px}.retained-time .window p{font-size:20px;margin-top:5px}.note-label{font-size:13px;color:#625b4e}.retained-time>p:not(.time){font-size:14px}.page-foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 16px;font-size:12px;margin-top:38px;line-height:1.7}.blank-stage{max-width:560px;margin:52px auto 70px;position:relative}.empty-paper,.loading-note{padding:30px 35px 26px}.empty-paper h1,.loading-title{font-size:32px;line-height:1.5;margin:12px 0 17px;padding-bottom:10px;background:url('/_blob/ca21bc89b8a03234da940fcb9db94854') left bottom/220px 11px no-repeat}.empty-paper p,.loading-copy{font-size:17px;padding-left:25px;background:url('/_blob/86c74f425173b6e3371430f19441c477') left center/13px 94% no-repeat}.state-symbol{width:100px;height:52px;color:#8e7961}.loading-sky{position:relative;width:180px;height:105px;margin-bottom:12px;overflow:hidden}.loading-sky::before{content:'';position:absolute;left:0;right:0;top:82px;height:5px;background:url('/_blob/48df054d9f1dbf8c6f38c170830d25dd') center/100% 100% no-repeat}.loading-sun{position:absolute;width:48px;height:47px;left:65px;top:22px;border:1px solid #a56b3d;border-radius:49% 51% 48% 52%;background:#e8c79055;animation:loading-rise 3.2s ease-in-out infinite}.loading-caption{font-size:12px;line-height:1.6;margin-top:24px;color:#625b4e}.loading-dot{display:inline-block;width:7px;height:7px;background:#a63827;border-radius:50%;margin-right:9px;animation:loading-breathe 1.2s ease-in-out infinite alternate}.status-note[data-state=switchfailed] h2{color:#a63827}.sky-page[data-light=night] .feedback-tabs button[aria-pressed=true]{color:#ffcfab}
@keyframes loading-rise{0%,100%{transform:translateY(17px);opacity:.5}50%{transform:translateY(-8px);opacity:.9}}@keyframes loading-breathe{from{opacity:.3}to{opacity:.9}}
@media(max-width:800px){.retained-stage{grid-template-columns:minmax(0,1fr) 260px;gap:26px}.retained-time{width:260px;padding:28px}.retained{margin-top:65px}}
@media(max-width:600px){.sky-page{padding:24px 20px 32px;min-height:100vh}.brand{font-size:20px;gap:8px}.brand img{width:34px;height:34px}.brand small{font-size:10px;letter-spacing:2px}.page-top>.action{font-size:13px}.feedback-layout{margin-top:31px}.feedback-context{margin-bottom:22px;flex-wrap:wrap;gap:10px}.feedback-context h1{font-size:38px}.feedback-tabs{gap:18px}.feedback-tabs button{font-size:17px}.status-note{margin:0 0 28px;width:100%;padding:23px 24px}.status-note h2{font-size:21px}.status-note p{font-size:14px}.status-actions{gap:6px 16px}.retained-stage{display:flex;flex-direction:column;gap:26px}.retained{margin:0;padding-bottom:23px}.retained-header{font-size:13px}.retained-score{font-size:clamp(68px,23cqw,99px)}.retained-verdict{font-size:16px;line-height:1.65}.retained-meta{margin-top:18px}.retained-time{align-self:flex-end;width:286px;max-width:94%;padding:28px 31px 32px;min-height:330px}.retained-time .time{font-size:54px}.retained-time .window{margin-top:27px;padding-left:8px}.blank-stage{margin:34px 0 45px}.empty-paper,.loading-note{padding:26px 24px}.empty-paper h1,.loading-title{font-size:27px;margin-top:8px}.empty-paper p,.loading-copy{font-size:16px}.page-foot{margin-top:28px;font-size:12px;gap:4px}.loading-sky{height:100px}}
@media(hover:hover) and (pointer:fine){button:hover:not(:disabled),a:hover{color:#a63827}.sky-page[data-light=night] .page-top a:hover,.sky-page[data-light=night] .feedback-tabs button:hover{color:#ffcfab}}
@media(prefers-reduced-motion:reduce){.loading-sun,.loading-dot{animation:none}}
@media(forced-colors:active){button:focus-visible,a:focus-visible{outline:2px solid Highlight;outline-offset:2px}.paper::before{background:Canvas!important;mask:none}.score-ink{display:none}.status-note p,.empty-paper p,.loading-copy,.status-note h2,.empty-paper h1,.loading-title{background-image:none}button[aria-pressed=true]{text-decoration:underline}}
