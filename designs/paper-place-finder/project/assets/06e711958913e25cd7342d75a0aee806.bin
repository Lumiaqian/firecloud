/* Active supporting-board composition only. Card material and inner anatomy come from the installed foundation. */
body{margin:0}
*{box-sizing:border-box}
p,h1,h2,h3,dl,dd{margin:0;font-weight:400}
.study{font:400 16px/1.6 var(--font-hand);color:var(--ink);background:#ddbc9d;min-height:1080px;padding:54px 5% 40px}
.wrap{max-width:1100px;margin:auto}
.heading{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 12px 24px}
.heading h1,.heading h2{font-size:27px}
.muted{font-size:13px;color:var(--ink-muted)}
.notes{margin-left:35px}
[data-sl-part="factor-group-header"]{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:14px}
[data-sl-part="factor-group-header"]>span{font-size:12px;color:var(--ink-muted)}
.note-foot{display:flex;justify-content:space-between;gap:20px;margin:17px 0 0 25px;font-size:12px;color:var(--ink-muted)}
.outlook{margin-top:46px}
.scroll{overflow-x:auto;padding:6px 3px 16px;scrollbar-width:thin}
.week-foot{display:flex;justify-content:space-between;gap:20px;font-size:12px;color:var(--ink-muted);margin:12px 12px 0;line-height:1.7}
.source{max-width:1100px;font-size:12px;color:var(--ink-muted);margin:32px auto 0}
@media(max-width:700px){.study{padding:30px 20px}.heading{flex-wrap:wrap;margin-left:0}.heading h1,.heading h2{font-size:24px}.notes{margin-left:0}.note-foot,.week-foot{flex-wrap:wrap;gap:6px}.note-foot{margin-left:20px}.outlook{margin-top:34px}}
