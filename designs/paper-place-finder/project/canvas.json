  "notes": {
    "alternativeWeather": {
      "page": "alternatives",
      "text": "未采用方案，仅供比较，不作为实现依据。\nB「主因摘记 + 七日纵览」保留；装订速写本、观测档案夹、暮天手札为前期构图备选。\n已采用的 A 详图在 02，完整桌面与手机首页在 01。",
      "w": 1100,
      "x": 0,
      "y": -300
    },
    "approvedTypography": {
      "page": "design-system",
      "text": "已同步 A：评分圈注、事件旁批、云层与空气分组、无折痕七日横笺。源设计系统与画布安装副本保持一致。\n字体为全文小赖，Logo 暂选 A；Logo 板内其他方案仅供对照。组件预览包含常规、封顶、缺测、恢复及动效关闭状态。",
      "w": 1100,
      "x": 0,
      "y": -300
    },
    "decisionStudy": {
      "page": "archive",
      "text": "「出门前的一页笔记」已否决：文案过长，弱化预报工具价值。仅留作历史对照。",
      "w": 900,
      "x": 0,
      "y": 10680
    },
    "flowCoverage": {
      "page": "flows",
      "text": "换城定位、收藏满额、抽屉手势与亏月。完整本地记录首页已移到 01，与正常首页并列。\n换城收起旧城分数；response 切换 success/error/cache。满额撤销先腾位置，保留原顺序。短拖回弹、长拖关闭、重开归零。月相不随预报日期变化。\n软键盘为占位模拟；不联网、不请求定位、不写浏览器存储。",
      "w": 1100,
      "x": 0,
      "y": -300
    },
    "forecastCoverage": {
      "page": "forecast-modes",
      "text": "预报专题：日轮、朝霞、封顶与缺测；左桌面、右手机，统一评分圈注、两组天气旁批与七日横笺。\n切换日期、朝晚霞及日轮时，分数、时间、批注、最高日联动，实况天空独立。缺测不记零分；封顶保留原因与降水、沙尘等补充项。固定样例，不连接预报接口。",
      "w": 1100,
      "x": 0,
      "y": -300
    },
    "motionCoverage": {
