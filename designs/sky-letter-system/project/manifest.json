  "libraries": [],
  "components": [
    {
      "name": "InkActions",
      "group": "墨迹控件",
      "summary": "墨迹操作展示无底色文字按钮、朱红选择笔迹、真实键盘焦点与收藏操作。"
    },
    {
      "name": "CitySearch",
      "group": "墨迹控件",
      "summary": "城市搜索以原稿的细线输入、手写标签与纸上结果行展示可清空的本地城市筛选。"
    },
    {
      "name": "PlaceRow",
      "group": "墨迹控件",
      "summary": "地点行把切换地点与切换收藏分为两个独立原生按钮，用“当前”文字和细下划线表示当前地点。"
    },
    {
      "name": "ObservationSheet",
      "group": "墨迹控件",
      "summary": "观测纸笺将批准原稿的桌面不规则纸面与移动贴底抽屉外观应用于原生模态 dialog。"
    },
    {
      "name": "PaperNote",
      "group": "预报纸笺",
      "summary": "PaperNote 用开口圈注的评分笺与右上方事件便笺，呈现同一次晨昏观测的判断和时间窗口。"
    },
    {
      "name": "ForecastStrip",
      "group": "预报纸笺",
      "summary": "ForecastStrip 是无折痕的连续七日横笺，用日期按钮、圈注最高日与选中划线呈现预报展望。"
    },
    {
      "name": "FactorGrid",
      "group": "预报纸笺",
      "summary": "FactorGrid 用云层与空气两组旁批，解释所选预测的数值、增减分及主要影响项。"
    },
    {
      "name": "StatusNote",
      "group": "读取与反馈",
      "summary": "StatusNote 在城市下用紧凑文字行说明已有记录的新鲜度，保留评分与时间两张纸；仅无记录时使用独立状态纸。"
    },
    {
      "name": "WeatherStage",
      "group": "天空与月相",
      "summary": "WeatherStage 是从已批准画笺提取的环境天气与固定纸笺参考，天气过场不改写所选预报事件。"
    },
    {
      "name": "MoonPhase",
      "group": "天空与月相",
      "summary": "MoonPhase 保留已批准月相札记的七种亮面与可见性状态，月相属于此刻，不随未来预报日期切换。"
    }
  ],
