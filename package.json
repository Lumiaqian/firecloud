{
  "name": "firecloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "结合高空云层、远端光路与空气质量的自然霞光指数预报与晨昏观测手记 PWA",
  "homepage": "https://lumiaqian.github.io/firecloud/",
  "scripts": {
    "dev": "python3 -m http.server 8765 --bind 127.0.0.1",
    "check": "for f in $(find js -name '*.mjs') sw.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "sync-modules": "node scripts/sync-modules.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
